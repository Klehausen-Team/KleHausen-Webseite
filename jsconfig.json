{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "lib": ["ES2020", "DOM"],
        "checkJs": false,
        "allowJs": true,
        "noEmit": true,
        "strict": false,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "**/*.js"
    ],
    "exclude": [
        "node_modules",
        "**/*.min.js"
    ]
}
